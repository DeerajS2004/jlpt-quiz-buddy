{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JLPT Practice",
  "version": "0.1.0",
  "identifier": "app.lovable.jlpt-practice",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:8080",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "JLPT Practice",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "Daily JLPT mock tests",
    "longDescription": "Practice JLPT N5–N1 with timed mock tests, custom JSON question sets, and progress tracking."
  }
}
